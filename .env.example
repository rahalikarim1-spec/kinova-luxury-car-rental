# Public site URL used for canonical URLs, hreflang, sitemap and structured data.
# On Vercel, set this to the production domain. Falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# Business contact details (override the placeholders in src/config/business.ts without code changes).
# International format, digits only for WhatsApp (e.g. 971501234567). Leave empty while pending.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Tracking (leave empty to disable). Never commit real IDs here.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Set to "true" on a private demo deployment to emit noindex + Disallow: /.
NEXT_PUBLIC_DEMO_NOINDEX=false
